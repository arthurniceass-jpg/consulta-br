{
  "name": "consulta-br",
  "version": "0.0.1",
  "author": "Grupo Consulta BR",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "npm run eslint && npm run typecheck:e2e && npm run prettier -- --check",
    "lint:fix": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "ng lint --max-warnings 0",
    "prettier": "prettier \"**/*.{ts,html}\"",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "ng test --no-watch",
    "test:unit:watch": "ng test --watch",
    "test:e2e": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@ionic/angular": "^9.0.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@angular/language-service": "~21.2.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "angular-eslint": "^21.0.0",
    "eslint": "^10.10.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.0.8"
  },
  "prettier": "@ionic/prettier-config",
  "description": "Consulta BR — app Ionic que consulta bancos, CNPJ, CEP e feriados pela BrasilAPI",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
